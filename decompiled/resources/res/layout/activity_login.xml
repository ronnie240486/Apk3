<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="false">
    <com.andyhax.Task.mATVViewBG
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/image_bg"
        android:background="@color/black_50"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="100">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_20sdp">
                <com.andyhax.Task.mATVView
                    android:layout_gravity="top|center_horizontal"
                    android:layout_width="@dimen/_130sdp"
                    android:layout_height="@dimen/_130sdp"
                    android:src="@drawable/home_logo"
                    android:scaleType="fitXY"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="@dimen/_260sdp"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ENTRE COM SEUS DADOS"/>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@color/lb_grey"
                        android:layout_gravity="center"
                        android:id="@+id/txt_mac"
                        android:tag="10"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="..."
                        android:layout_weight="1"
                        android:textAllCaps="true"
                        android:textAlignment="center"/>
                </LinearLayout>
                <EditText
                    android:textColor="#ffffffff"
                    android:textColorHint="@color/lb_grey"
                    android:gravity="center"
                    android:id="@+id/hax_username"
                    android:tag="1"
                    android:background="@drawable/atvr_login_btn_selected"
                    android:padding="@dimen/_10sdp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:hint="USUÁRIO"
                    android:singleLine="true"
                    android:imeOptions="actionNext">
                    <requestFocus/>
                </EditText>
                <EditText
                    android:textColor="#ffffffff"
                    android:textColorHint="@color/lb_grey"
                    android:gravity="center"
                    android:id="@+id/hax_password"
                    android:tag="2"
                    android:background="@drawable/atvr_login_btn_selected"
                    android:padding="@dimen/_10sdp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:hint="SENHA"
                    android:singleLine="true"
                    android:imeOptions="actionNext"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="20sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/hax_login"
                    android:tag="3"
                    android:background="@drawable/atvr_login_btn_selector"
                    android:padding="@dimen/_10sdp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="CONECTAR"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:tag="4"
        android:background="#d7615701"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_60sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/hax_loading"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_25sdp"
                android:layout_margin="@dimen/_5sdp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ffdfdfdf"
                android:layout_gravity="center"
                android:tag="5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_35sdp"
                android:text="Carregando..."
                android:layout_weight="1"
                android:textAlignment="center"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
