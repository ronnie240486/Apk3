<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient
                android:startColor="@color/atv1"
                android:endColor="@color/atv2"
                android:angle="45"
                android:centerColor="@color/atv2"/>
            <stroke
                android:width="2dp"
                android:color="#ff50586f"/>
            <corners android:radius="25dp"/>
            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <gradient
                android:startColor="@color/atv1"
                android:endColor="@color/atv2"
                android:angle="45"
                android:centerColor="@color/atv2"/>
            <stroke
                android:width="2dp"
                android:color="#ff50586f"/>
            <corners android:radius="25dp"/>
            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="@color/atv1"
                android:endColor="@color/atv2"
                android:angle="45"
                android:centerColor="@color/atv2"/>
            <stroke
                android:width="2dp"
                android:color="#ff50586f"/>
            <corners android:radius="25dp"/>
            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="@color/atv1"
                android:endColor="@color/atv1"
                android:angle="45"
                android:centerColor="@color/atv1"/>
            <corners android:radius="25dp"/>
            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp"/>
        </shape>
    </item>
</selector>
